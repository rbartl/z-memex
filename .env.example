# Required. Compose refuses to start without a token; use a long random one.
export MCP_AUTH_TOKEN=change-me

# Required. Web UI login — change the password.
export UI_USER=admin
export UI_PASS=change-me

# Optional. Extraction backend: "ollama" (default, fully local) or "anthropic".
# export EXTRACTOR=ollama

# Optional. Ollama models — pull them first.
#
# EMBED_MODEL must produce vectors of the width the schema declares (1024 since
# migration 012). Changing it means a migration and a full re-embed, which the
# server performs at startup. bge-m3 was chosen by measurement; see
# cmd/rankeval and migration 012.
# export EMBED_MODEL=bge-m3
# export OLLAMA_EXTRACT_MODEL=gemma4:26b
# export OLLAMA_CHAT_MODEL=llama3.2

# Optional. Background extraction (entity + cross-memory relations) runs on an
# unbounded queue so a burst of stores can't swamp the extractor. One job at a
# time by default; raise it only if the backend serves parallel calls.
# export EXTRACTION_WORKERS=1

# Only needed when EXTRACTOR=anthropic.
# export ANTHROPIC_API_KEY=sk-ant-...

# Only needed when running the server outside docker compose — compose sets
# both of these itself.
export POSTGRES_URL=postgres://memex:memex@localhost:5433/memex?sslmode=disable
export OLLAMA_URL=http://localhost:11434
